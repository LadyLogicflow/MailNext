# Vorlage für die Datei .env (Testinstanz auf dem Pi). Kopieren nach .env und die Werte eintragen; .env nie weitergeben.
# Mindestens 32 zufällige Zeichen (z. B. mit: openssl rand -base64 36)
MAILNEXT_HAUPTSCHLUESSEL=
# Adresse oder Name des Pi im Heimnetz, ohne http:// (z. B. 192.168.1.50)
MAILNEXT_PI_ADRESSE=
# Betreiber-Oberfläche ohne Anmeldung (nur Heimnetz, siehe PI-TESTINSTANZ.md): "offen" einschalten, sonst leer lassen (= Portal-Anmeldung)
MAILNEXT_BETREIBER_AUTH=
# Im Offen-Modus: Adresse für das Audit-Log und als Standard-Empfänger der Testmail
MAILNEXT_BETREIBER_OFFEN_EMAIL=
# Sobald Tunnel/Domain stehen: öffentliche https-Adresse (ohne Schrägstrich am Ende) und 1 bei einem Proxy/Tunnel vor Port 8001
MAILNEXT_BASIS_URL=
MAILNEXT_PROXIES=
